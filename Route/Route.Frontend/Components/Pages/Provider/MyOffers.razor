@page "/provider/my-offers"

@using System.Linq
@using System.Threading
@using Route.Shared.Enums
@using Route.Shared.DTOs

@inject VehicleOffersClient OffersApi
@inject CapacityRequestsClient RequestsApi
@inject ProvidersClient ProvidersApi
@inject IDialogService Dialog
@inject ISnackbar Snackbar

@* Simulación de roles mientras no hay autenticación *@
@code { [Parameter] public bool IsAdmin { get; set; } = false; }

<MudStack Spacing="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h5">Mis ofertas</MudText>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreateDialog">
            Nueva oferta
        </MudButton>
    </MudStack>

    <!-- Filtros -->
    <MudPaper Class="p-4">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
            <MudTextField @bind-Value="_filters.Term"
                          Label="Buscar (notas/moneda)"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />

            @if (IsAdmin)
                        {
            <!-- Autocomplete proveedor (ADMIN) -->
            <MudAutocomplete T="Provider"
                             @bind-Value="_selectedProvider"
                             Label="Proveedor"
                             ToStringFunc="ProviderToString"
                             SearchFunc="SearchProviders"
                             ResetValueOnEmptyText="true"
                             Clearable="true"
                             Dense="true" />
                        }
                        else
            {
                <!-- Modo proveedor: fijo (simulado) -->
                <MudTextField T="int" Value="_currentProviderId" Label="Proveedor (ID)" ReadOnly="true" />
            }

            <!-- Autocomplete requerimiento -->
            <MudAutocomplete T="CapacityRequest"
                             @bind-Value="_selectedRequest"
                             Label="Requerimiento"
                             ToStringFunc="ReqToString"
                             SearchFunc="SearchRequests"
                             ResetValueOnEmptyText="true"
                             Clearable="true"
                             Dense="true" />

            <!-- Estado (lookups desde backend, ya en español) -->
            <MudSelect T="VehicleOfferStatus?" Label="Estado" @bind-Value="_filters.Status" Clearable="true" Dense="true">
                @foreach (var it in _statusLookups)
                {
                    <MudSelectItem T="VehicleOfferStatus?" Value="@((VehicleOfferStatus?)it.Value)">
                        @it.Label
                    </MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker Label="Desde (creación)" @bind-Date="_filters.FromCreated" />
            <MudDatePicker Label="Hasta (creación)" @bind-Date="_filters.ToCreated" />

            <MudSwitch T="bool" @bind-Checked="_filters.VisibleForProvider" Color="Color.Primary" />
            <MudText>Solo visibles para mi proveedor</MudText>

            <MudButton OnClick="Reload" Color="Color.Primary" Variant="Variant.Filled">Aplicar</MudButton>
            <MudButton OnClick="ClearFilters" Variant="Variant.Outlined">Limpiar</MudButton>
        </MudStack>
    </MudPaper>

    <!-- Tabla -->
    <MudTable Items="_items" Dense="true" Hover="true" Bordered="true">
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Req</MudTh>
            <MudTh>Proveedor</MudTh>
            <MudTh>Cant.</MudTh>
            <MudTh>Precio</MudTh>
            <MudTh>Modo</MudTh>
            <MudTh>Moneda</MudTh>
            <MudTh>Vence</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Creado</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Id</MudTd>
            <MudTd>@context.CapacityRequestId</MudTd>
            <MudTd>@(string.IsNullOrWhiteSpace(context.ProviderName) ? $"#{context.ProviderId}" : context.ProviderName)</MudTd>
            @* <MudTd>@(IsAdmin? context.ProviderName: _currentProviderLabel)</MudTd> *@
            <MudTd>@context.Quantity</MudTd>
            <MudTd>@context.Price</MudTd>
            <MudTd>@context.PriceModeText</MudTd>
            <MudTd>@context.Currency</MudTd>
            <MudTd>@(context.ValidUntil.HasValue? context.ValidUntil.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-")</MudTd>
            <MudTd>
                <MudChip T="string" Variant="Variant.Filled" Color="@ChipColor(context.Status)">
                    @context.StatusText
                </MudChip>
            </MudTd>
            <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd>
                <MudMenu>
                    <ActivatorContent>
                        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" />
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@(() => OpenEditDialog(context))">Editar</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <!-- Paginación -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText>Total: @_total</MudText>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudText>Por página</MudText>
            <MudSelect T="int" @bind-Value="_pagination.RecordsNumber" Style="width:100px"
                       OnClose="@(async _ => await OnPageSizeChanged(_pagination.RecordsNumber))">
                @foreach (var size in _pageSizes)
                {
                    <MudSelectItem Value="@size">@size</MudSelectItem>
                }
            </MudSelect>

            <MudPagination Page="@_pagination.Page" Count="@_pages" PageChanged="OnPageChanged" />
        </MudStack>
    </MudStack>
</MudStack>

@code {
    // ===== Estado UI =====
    List<VehicleOfferDto> _items = new();
    int _total = 0;
    int _pages => (int)Math.Ceiling((_total == 0 ? 1 : _total) / (double)_pagination.RecordsNumber);
    readonly int[] _pageSizes = new[] { 10, 20, 50 };

    // Lookups de estado (desde backend)
    List<EnumLookup<VehicleOfferStatus>> _statusLookups = new();

    // Proveedor "actual" para modo proveedor (sin auth todavía)
    int _currentProviderId = 1;                 // <-- ajusta si quieres simular otro
    string _currentProviderLabel => $"#{_currentProviderId}";

    // ADMIN
    Provider? _selectedProvider;

    // Requerimiento seleccionado
    CapacityRequest? _selectedRequest;

    // Filtros + paginación
    class Filters
    {
        public string? Term { get; set; }
        public VehicleOfferStatus? Status { get; set; }
        public DateTime? FromCreated { get; set; }
        public DateTime? ToCreated { get; set; }
        public bool VisibleForProvider { get; set; } = true;
    }

    Filters _filters = new();
    PaginationDTO _pagination = new() { Page = 1, RecordsNumber = 20, SortBy = "CreatedAt", SortDir = "desc" };

    protected override async Task OnInitializedAsync()
    {
        // 1) Lookups (etiquetas en español)
        _statusLookups = await OffersApi.GetStatusLookupsAsync() ?? new();
        // 2) Grilla
        await Reload();
    }

    // ===== Carga =====
    async Task Reload()
    {
        _pagination.Term = string.IsNullOrWhiteSpace(_filters.Term) ? null : _filters.Term!.Trim();

        int? providerId = IsAdmin ? _selectedProvider?.Id : _currentProviderId;

        var page = await OffersApi.GetPagedAsync(
            p: _pagination,
            capacityRequestId: _selectedRequest?.Id,
            providerId: providerId,
            vehicleId: null,
            status: _filters.Status,
            fromCreated: _filters.FromCreated,
            toCreated: _filters.ToCreated,
            visibleForProvider: _filters.VisibleForProvider
        );

        _items = page.Items?.ToList() ?? new();
        _total = page.Total;

        StateHasChanged();
    }

    void ClearFilters()
    {
        _filters = new Filters { VisibleForProvider = true };
        _selectedRequest = null;
        if (!IsAdmin) _selectedProvider = null;

        _pagination.Page = 1;
        _pagination.RecordsNumber = 20;
        _pagination.SortBy = "CreatedAt";
        _pagination.SortDir = "desc";
        _pagination.Term = null;

        _ = Reload();
    }

    private async Task OnPageChanged(int page)
    {
        _pagination.Page = page;
        await Reload();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pagination.RecordsNumber = size;
        _pagination.Page = 1;
        await Reload();
    }

    // ===== Autocomplete: Proveedores (ADMIN) =====
    private async Task<IEnumerable<Provider>> SearchProviders(string value, CancellationToken ct)
    {
        var page = await ProvidersApi.GetPagedAsync(
            term: string.IsNullOrWhiteSpace(value) ? null : value,
            page: 1,
            recordsNumber: 10,
            sortBy: "Name",
            sortDir: "asc",
            cancellationToken: ct
        );
        ct.ThrowIfCancellationRequested();
        return page?.Items ?? Enumerable.Empty<Provider>();
    }

    private static string ProviderToString(Provider? p)
        => p is null ? string.Empty : $"{p.Name} (#{p.Id})";

    // ===== Autocomplete: Requerimientos =====
    private async Task<IEnumerable<CapacityRequest>> SearchRequests(string value, CancellationToken ct)
    {
        var search = new PaginationDTO
        {
            Page = 1,
            RecordsNumber = 10,
            Term = string.IsNullOrWhiteSpace(value) ? null : value,
            SortBy = "ServiceDate",
            SortDir = "desc"
        };

        var page = await RequestsApi.GetPagedAsync(
            p: search,
            status: CapacityReqStatus.Open,
            providerId: null,
            visibleForProvider: null,
            fromDate: null,
            toDate: null
        );

        ct.ThrowIfCancellationRequested();
        return page.Items ?? Enumerable.Empty<CapacityRequest>();
    }

    private static string ReqToString(CapacityRequest? r)
        => r is null ? string.Empty : $"#{r.Id} | {r.ServiceDate:yyyy-MM-dd} {r.Zone}";

    // ===== Diálogos =====
    private async Task OpenCreateDialog()
    {
        int? providerId = IsAdmin ? _selectedProvider?.Id : _currentProviderId;

        if (_selectedRequest is null)
        {
            Snackbar.Add("Selecciona un requerimiento para crear la oferta.", Severity.Warning);
            return;
        }
        if (providerId is null or <= 0)
        {
            Snackbar.Add("Selecciona un proveedor válido.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(OfferDialog.CapacityRequestId), _selectedRequest.Id },
            { nameof(OfferDialog.ProviderId), providerId.Value }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true };

        var dialog = Dialog.Show<OfferDialog>("Nueva oferta", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
            await Reload();
    }

    private async Task OpenEditDialog(VehicleOfferDto offer)
    {
        var parameters = new DialogParameters
        {
            { nameof(OfferDialog.CapacityRequestId), offer.CapacityRequestId },
            { nameof(OfferDialog.ProviderId), offer.ProviderId },
            { nameof(OfferDialog.CurrentOffer), new VehicleOffer  // si OfferDialog espera entidad
                {
                    Id = offer.Id,
                    CapacityRequestId = offer.CapacityRequestId,
                    ProviderId = offer.ProviderId,
                    VehicleId = null,
                    Quantity = offer.Quantity,
                    OfferedWeightKg = offer.OfferedWeightKg,
                    OfferedVolumeM3 = offer.OfferedVolumeM3,
                    Price = offer.Price,
                    Currency = offer.Currency,
                    PriceMode = offer.PriceMode,
                    ValidUntil = offer.ValidUntil,
                    Notes = offer.Notes,
                    Status = offer.Status,
                    CreatedAt = offer.CreatedAt
                }
            }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true };

        var dialog = Dialog.Show<OfferDialog>($"Editar oferta #{offer.Id}", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
            await Reload();
    }

    // ===== Helpers =====
    static Color ChipColor(VehicleOfferStatus status) => status switch
    {
        VehicleOfferStatus.Draft => Color.Default,
        VehicleOfferStatus.Sent => Color.Info,
        VehicleOfferStatus.Accepted => Color.Success,
        VehicleOfferStatus.Rejected => Color.Error,
        VehicleOfferStatus.Withdrawn => Color.Warning,
        VehicleOfferStatus.Expired => Color.Dark,
        _ => Color.Default
    };
}