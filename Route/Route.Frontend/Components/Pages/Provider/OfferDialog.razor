@using MudBlazor
@using Route.Shared.Enums
@using Route.Shared.DTOs           @* VehicleOfferDto, VehiclePickDto *@
@using Route.Shared.Entities       @* Provider *@
@using Route.Shared.Services.Api

@inject VehicleOffersClient OffersApi
@inject ProvidersClient ProvidersApi
@inject VehiclesClient VehiclesApi
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">
                @(_isEdit
                                ? $"Editar oferta #{_offerId} · Req #{CapacityRequestId}{_reqSummary}"
                                : $"Nueva oferta · Req #{CapacityRequestId}{_reqSummary}")
            </MudText>

            @if (ReqOnlyTargetProvider is not null)
            {
                <MudAlert Severity="@(ReqOnlyTargetProvider == true ? Severity.Warning : Severity.Info)"
                          Elevation="0" Dense="true">
                    @(ReqOnlyTargetProvider == true
                                    ? "Requerimiento dirigido a proveedor destino (sólo ese proveedor ve este requerimiento)."
                                    : "Requerimiento abierto (visible para todos los proveedores).")
            </MudAlert>
                        }

            <MudStack Row="true" Spacing="2">
                @if (IsAdmin)
                {
                    <MudAutocomplete T="Provider"
                                     @bind-Value="_selectedProvider"
                                     Label="Proveedor"
                                     ToStringFunc="@(p => p is null ? string.Empty : $"{p.Name} (#{p.Id})")"
                                     SearchFunc="SearchProviders"
                                     ResetValueOnEmptyText="true"
                                     Clearable="false"
                                     Dense="true" />
                }
                else
                {
                    <MudTextField T="int" Label="Proveedor" Value="@ProviderId" ReadOnly="true" />
                }

                <MudTextField T="int" Label="Requerimiento" Value="@CapacityRequestId" ReadOnly="true" />
            </MudStack>

            @* Selección de vehículo por disponibilidad *@
            <MudAutocomplete T="VehiclePickDto"
                             @bind-Value="_selectedVehicle"
                             Label="Placa (disponible)"
                             ToStringFunc="@(VehicleToString)"
                             SearchFunc="SearchAvailableVehicles"
                             Dense="true"
                             Clearable="true"
                             ResetValueOnEmptyText="true" />
            @if (_selectedVehicle is not null && !string.IsNullOrWhiteSpace(_selectedVehicle.CapacityTonnageLabel))
            {
                <MudText Class="mud-text-caption mud-muted-text">
                    Capacidad ref.: @_selectedVehicle.CapacityTonnageLabel
                </MudText>
            }

            <MudStack Row="true" Spacing="2">
                <MudNumericField T="int" @bind-Value="_quantity" Label="Cantidad" Min="1" Immediate="true" Required="true" />
                <MudSelect T="PriceMode" Label="Modo precio" @bind-Value="_priceMode" Dense="true">
                    <MudSelectItem Value="PriceMode.PerVehicle">Por vehículo</MudSelectItem>
                    <MudSelectItem Value="PriceMode.Total">Total</MudSelectItem>
                </MudSelect>
            </MudStack>

            <MudStack Row="true" Spacing="2">
                <MudNumericField T="double" @bind-Value="_offeredWeightKg" Label="Peso ofrecido (kg)" Min="0" Immediate="true" />
                <MudNumericField T="double" @bind-Value="_offeredVolumeM3" Label="Volumen ofrecido (m³)" Min="0" Immediate="true" />
            </MudStack>

            <MudStack Row="true" Spacing="2">
                <MudNumericField T="decimal" @bind-Value="_price" Label="Precio" Min="0" Immediate="true" Required="true" />
                <MudTextField @bind-Value="_currency" Label="Moneda" MaxLength="3" />
            </MudStack>

            <MudStack Row="true" Spacing="2">
                <MudDatePicker @bind-Date="_validUntilDate" Label="Válida hasta (fecha)" />
                <MudTimePicker @bind-Time="_validUntilTime" Label="Válida hasta (hora)" />
            </MudStack>

            <MudTextField @bind-Value="_notes" Label="Notas" Lines="3" />
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled">Guardar</MudButton>
        <MudButton OnClick="Close" Variant="Variant.Outlined">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // ========= Parámetros =========
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int CapacityRequestId { get; set; }
    [Parameter] public int ProviderId { get; set; }

    // Edición (DTO existente)
    [Parameter] public VehicleOfferDto? CurrentOffer { get; set; }

    // Modo admin (puede cambiar proveedor)
    [Parameter] public bool IsAdmin { get; set; } = false;

    // Datos opcionales del requerimiento (para resumen y disponibilidad)
    [Parameter] public DateTime? ReqServiceDate { get; set; }
    [Parameter] public string? ReqZone { get; set; }
    [Parameter] public TimeSpan? ReqWindowStart { get; set; }
    [Parameter] public TimeSpan? ReqWindowEnd { get; set; }
    [Parameter] public bool? ReqOnlyTargetProvider { get; set; }

    // ========= Estado =========
    bool _isEdit => CurrentOffer is not null;
    int _offerId => CurrentOffer?.Id ?? 0;

    Provider? _selectedProvider;
    VehiclePickDto? _selectedVehicle;
    int? _vehicleId => _selectedVehicle?.Id;

    int _quantity = 1;
    double _offeredWeightKg;
    double _offeredVolumeM3;

    decimal _price;
    string _currency = "PEN";
    PriceMode _priceMode = PriceMode.PerVehicle;

    DateTime? _validUntilDate;
    TimeSpan? _validUntilTime;

    string? _notes;

    string _reqSummary = string.Empty;

    protected override void OnParametersSet()
    {
        // Resumen del requerimiento (usando parámetros, no propiedades inexistentes del DTO)
        _reqSummary = BuildReqSummary();

        if (!_isEdit)
        {
            _quantity = 1;
            _currency = "PEN";
            _priceMode = PriceMode.PerVehicle;
            return;
        }

        _quantity = CurrentOffer!.Quantity;
        _offeredWeightKg = CurrentOffer!.OfferedWeightKg;
        _offeredVolumeM3 = CurrentOffer!.OfferedVolumeM3;
        _price = CurrentOffer!.Price;
        _currency = CurrentOffer!.Currency;
        _priceMode = CurrentOffer!.PriceMode;
        _notes = CurrentOffer!.Notes;

        if (CurrentOffer!.ValidUntil is DateTime vu)
        {
            _validUntilDate = vu.Date;
            _validUntilTime = vu.TimeOfDay;
        }
    }

    private string BuildReqSummary()
    {
        var parts = new List<string>();
        if (ReqServiceDate is DateTime d) parts.Add(d.ToString("yyyy-MM-dd"));
        if (!string.IsNullOrWhiteSpace(ReqZone)) parts.Add(ReqZone!);
        if (ReqWindowStart.HasValue && ReqWindowEnd.HasValue)
            parts.Add($"{ReqWindowStart:hh\\:mm}-{ReqWindowEnd:hh\\:mm}");
        return parts.Count > 0 ? $" · {string.Join(" · ", parts)}" : string.Empty;
    }

    // --- Proveedores (admin) ---
    private async Task<IEnumerable<Provider>> SearchProviders(string value, CancellationToken ct)
    {
        var page = await ProvidersApi.GetPagedAsync(
            term: string.IsNullOrWhiteSpace(value) ? null : value,
            page: 1, recordsNumber: 10, sortBy: "Name", sortDir: "asc", cancellationToken: ct);

        ct.ThrowIfCancellationRequested();
        return page?.Items ?? Enumerable.Empty<Provider>();
    }

    // --- Placas disponibles ---
    private async Task<IEnumerable<VehiclePickDto>> SearchAvailableVehicles(string value, CancellationToken ct)
    {
        var providerId = IsAdmin ? (_selectedProvider?.Id ?? ProviderId) : ProviderId;
        var serviceDate = ReqServiceDate ?? DateTime.Today; // si no te lo pasan, fallback al hoy

        var items = await VehiclesApi.GetAvailableAsync(
            providerId: providerId,
            serviceDate: serviceDate,
            term: string.IsNullOrWhiteSpace(value) ? null : value,
            cancellationToken: ct);

        ct.ThrowIfCancellationRequested();
        return items ?? Enumerable.Empty<VehiclePickDto>();
    }

    private static string VehicleToString(VehiclePickDto? v)
        => v is null ? string.Empty
                     : (string.IsNullOrWhiteSpace(v.CapacityTonnageLabel)
                        ? v.Plate
                        : $"{v.Plate} ({v.CapacityTonnageLabel})");

    private async Task Save()
    {
        // Válida hasta
        DateTime? validUntil = null;
        if (_validUntilDate.HasValue)
        {
            var t = _validUntilTime ?? new TimeSpan(23, 59, 0);
            validUntil = _validUntilDate.Value.Date + t;
        }

        // Moneda segura
        var safeCurrency = string.IsNullOrWhiteSpace(_currency) ? "PEN" : _currency.Trim().ToUpperInvariant();
        if (safeCurrency.Length > 3) safeCurrency = safeCurrency[..3];

        var providerIdForSave = IsAdmin ? (_selectedProvider?.Id ?? ProviderId) : ProviderId;

        // var dto = new SaveVehicleOfferDto(
        //     CapacityRequestId: CapacityRequestId,
        //     ProviderId: providerIdForSave,
        //     VehicleId: _vehicleId, // opcional
        //     Quantity: Math.Max(1, _quantity),
        //     OfferedWeightKg: Math.Max(0, _offeredWeightKg),
        //     OfferedVolumeM3: Math.Max(0, _offeredVolumeM3),
        //     Price: Math.Max(0, _price),
        //     Currency: safeCurrency,
        //     PriceMode: _priceMode,
        //     ValidUntil: validUntil,
        //     Notes: string.IsNullOrWhiteSpace(_notes) ? null : _notes!.Trim()
        // );

        var dto = new SaveVehicleOfferDto
        {
            CapacityRequestId = CapacityRequestId,
            ProviderId = providerIdForSave,
            VehicleId = _vehicleId,
            Quantity = Math.Max(1, _quantity),
            OfferedWeightKg = Math.Max(0, _offeredWeightKg),
            OfferedVolumeM3 = Math.Max(0, _offeredVolumeM3),
            Price = Math.Max(0, _price),
            Currency = safeCurrency,
            PriceMode = _priceMode,
            ValidUntil = validUntil,
            Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes!.Trim(),
            Lines = null
        };

        var resp = _isEdit
            ? await OffersApi.UpdateAsync(_offerId, dto)
            : await OffersApi.CreateAsync(dto);

        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Oferta guardada.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }

        var body = await resp.Content.ReadAsStringAsync();
        Snackbar.Add($"Error al guardar: {(int)resp.StatusCode} - {body}", Severity.Error);
    }

    void Close() => MudDialog.Cancel();
}
